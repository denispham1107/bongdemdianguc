{
  // PHONG CHO VA TRANG THAI TRAN DAU.
  //
  // Vi sao dung Realtime Database cho phan nay ma khong dung Firestore:
  // RTDB co onDisconnect() - nguoi choi dong tab giua tran thi tu bien khoi
  // phong. Firestore KHONG co thu do, va mot phong day "nguoi ma" thi tran
  // khong bao gio ket thuc duoc.
  //
  // Nguoc lai, ho so nguoi choi va trang quan tri nam o Firestore vi can
  // sap xep, loc va phan trang - RTDB gan nhu khong lam duoc.

  "rules": {
    ".read": false,
    ".write": false,

    "phong": {
      ".read": "auth != null",

      "$maPhong": {
        // Bon duong duoc ghi vao mot phong:
        //  1. phong chua ton tai  -> dang tao moi
        //  2. minh la chu phong
        //  3. minh la admin       -> nut "Giai tan" trong trang quan tri.
        //     Truoc day thieu ve nay nen nut do bam khong an gi: luat tu choi
        //     im lang, trang web khong bao loi, nhin het nhu nut hong.
        //  4. XOA mot phong da chet. REST khong co onDisconnect nen chu phong
        //     dong tab la phong nam lai vinh vien - phai cho nguoi khac don ho.
        //     Chi cho XOA (newData khong ton tai), khong cho sua: khong ai muon
        //     ai do vao sua phong cua minh chi vi minh mat mang mot phut.
        ".write": "auth != null && ( !data.exists() || data.child('hostUid').val() === auth.uid || newData.child('hostUid').val() === auth.uid || root.child('quantri').child(auth.uid).exists() || ( !newData.exists() && ( !data.hasChild('capNhatLuc') || data.child('capNhatLuc').val() < now - 60000 ) ) )",

        "hostUid":   { ".validate": "newData.val() === auth.uid || data.val() === auth.uid" },
        "hostTen":   { ".validate": "newData.isString() && newData.val().length <= 16" },
        "ten":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "manChoi":   { ".validate": "newData.val() === 'Act1' || newData.val() === 'Act2'" },
        "trangThai": { ".validate": "newData.val().matches(/^(cho|demNguoc|dangChoi|xong)$/)" },
        "toiDa":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
        "soNguoi": {
          // Nguoi VAO phong cung phai tang so nay, ma ho khong phai host - nen
          // rieng o nay ai dang nhap cung ghi duoc. Bu lai, chi duoc nhich MOT
          // don vi mot lan: khong ai dat bua thanh 0 de chen vao phong day.
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && ( !data.exists() || root.child('phong').child($maPhong).child('hostUid').val() === auth.uid || newData.val() === data.val() + 1 || newData.val() === data.val() - 1 )"
        },
        "taoLuc":    { ".validate": "newData.isNumber()" },
        "batDauLuc": { ".validate": "newData.isNumber()" },

        // Nhip song cua phong. REST khong co onDisconnect, nen chu phong phai
        // tu bao "toi con day" moi giay; phong nao lang qua lau thi sanh loc
        // di. Chi chu phong ghi - da duoc .write o cap tren lo.
        "capNhatLuc": { ".validate": "newData.isNumber()" },
        "thangUid":  { ".validate": "newData.isString()" },

        "nguoiChoi": {
          ".read": "auth != null",

          "$uid": {
            // Moi nguoi tu ghi o cua minh. Host duoc them quyen XOA de duoi ra.
            ".write": "auth.uid === $uid || root.child('phong').child($maPhong).child('hostUid').val() === auth.uid",

            // Luat RTDB KHONG co numChildren() (chi Firestore moi co size()),
            // nen suc chua phong duoc giu bang truong 'soNguoi' o cap tren:
            // "soNguoi" da co .validate <= 4, va phia trinh duyet dung mot
            // giao dich (transaction) de tang no - hai nguoi bam cung luc thi
            // chi mot nguoi thang.
            "ten":     { ".validate": "newData.isString() && newData.val().length <= 16" },
            "sanSang": { ".validate": "newData.isBoolean()" },
            "cho":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "vaoLuc":  { ".validate": "newData.isNumber()" },
            "$khac":   { ".validate": false }
          }
        }
      }
    },

    "tran": {
      "$maPhong": {
        // Chi nguoi DANG TRONG phong moi doc duoc trang thai tran
        ".read": "auth != null && root.child('phong').child($maPhong).child('nguoiChoi').child(auth.uid).exists()",

        // Host ghi duoc ca nhanh nay. Thieu dong nay thi lenh onDisconnect
        // "khi host mat ket noi thi xoa tran" bi tu choi, va vi no bi tu choi
        // nen CA VIEC TAO PHONG that bai - tuy khong lien quan gi den phong.
        ".write": "auth != null && ( root.child('phong').child($maPhong).child('hostUid').val() === auth.uid || root.child('quantri').child(auth.uid).exists() || !root.child('phong').child($maPhong).exists() )",

        "nguoi": {
          "$uid": {
            // Vi tri: moi nguoi tu ghi cua minh - phai tuc thi, khong the cho
            // host duyet tung buoc chan.
            ".write": "auth.uid === $uid",

            // Nhung MAU thi khong ai tu khai: chi host ghi.
            "mau": { ".write": "root.child('phong').child($maPhong).child('hostUid').val() === auth.uid" }
          }
        },

        // Quai, sat thuong va vong bo: chi host quyet.
        // CombatUtil.AreaShock va AreaFreeze dung Random.value - de moi may tu
        // gieo thi nguoi nay thay dich bi dong bang, nguoi kia thay khong.
        "quai":      { ".write": "root.child('phong').child($maPhong).child('hostUid').val() === auth.uid" },
        "satThuong": { ".write": "root.child('phong').child($maPhong).child('hostUid').val() === auth.uid" },
        "vongBo":    { ".write": "root.child('phong').child($maPhong).child('hostUid').val() === auth.uid" },

        "kyNang": {
          "$id": {
            // Ai tung ky nang thi nguoi do ghi, de bam phim la ra chieu ngay
            // chu khong doi mot vong tuan hoan qua host.
            ".write": "auth != null && newData.child('uid').val() === auth.uid"
          }
        }
      }
    },

    "hienDien": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },

    // CHO BAT TAY CUA CONG CU DO DO TRE (buoc 0 giai doan 2).
    //
    // Hai may trao doi offer/answer/ICE qua day de tim duong noi thang voi
    // nhau. Chi la cho hen gap: noi duoc roi thi khong ai dung den nua.
    // Du lieu o day song vai giay, khong co gi dang giu.
    "dothu": {
      "$maPhien": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    // DANH SACH ADMIN - BAN SAO CHO REALTIME DATABASE.
    //
    // Danh sach that nam o Firestore (collection 'quantri'), nhung luat cua
    // Realtime Database KHONG doc duoc Firestore - hai co so du lieu khac han
    // nhau. Nen phai giu them mot ban o day, chi chua uid, khong chua gi khac.
    //
    // Khong ai ghi duoc tu trinh duyet, giong het ben Firestore: them admin
    // bang tay trong Console hoac bang script chay tren may.
    "quantri": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
